QWidget {
    background: #ffffff;
    color: #1d1d1f;
    font-family: "Segoe UI", system-ui, sans-serif;
    font-size: 15px;
}

QLabel#PageTitle {
    font-size: 28px;
    font-weight: 600;
    color: #1d1d1f;
}

QLabel#MutedText {
    color: #7a7a7a;
    font-size: 15px;
}

QLabel#WarningText {
    color: #8a5a00;
    background: #fff8e7;
    border: 1px solid #f0d28a;
    border-radius: 11px;
    padding: 12px 16px;
}

QLabel#WarningBanner {
    color: #8a5a00;
    background: #fff8e7;
    border: 1px solid #f0d28a;
    border-radius: 11px;
    padding: 12px 16px;
}

QLabel#PathLabel,
QLabel#SummaryLabel,
QTextEdit#SummaryLabel {
    background: #f5f5f7;
    border: 1px solid #e0e0e0;
    border-radius: 18px;
    padding: 18px;
    line-height: 1.5;
}

QPushButton {
    min-height: 36px;
    padding: 8px 18px;
    border-radius: 18px;
    font-weight: 500;
}

QPushButton#PrimaryButton {
    background: #0066cc;
    color: #ffffff;
    border: 1px solid #0066cc;
}

QPushButton#PrimaryButton:pressed {
    background: #0071e3;
}

QPushButton#SecondaryButton {
    background: #ffffff;
    color: #0066cc;
    border: 1px solid #0066cc;
}

QPushButton#UtilityButton {
    background: #f5f5f7;
    color: #1d1d1f;
    border: 1px solid #e0e0e0;
}

QListWidget,
QTableWidget {
    background: #fafafc;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    alternate-background-color: #ffffff;
}

QHeaderView::section {
    background: #f5f5f7;
    color: #1d1d1f;
    border: 0;
    border-bottom: 1px solid #e0e0e0;
    padding: 8px;
    font-weight: 600;
}

QTableWidget::item {
    padding: 6px;
}

QComboBox {
    min-height: 34px;
    padding: 4px 12px;
    border-radius: 11px;
    border: 1px solid #e0e0e0;
    background: #ffffff;
}

QStatusBar#CreditStatusBar {
    background: #f5f5f7;
    color: #7a7a7a;
    border-top: 1px solid #e0e0e0;
    font-size: 12px;
}

QStatusBar#CreditStatusBar::item {
    border: 0;
}
